 "named": [
  {
   "name": "Corinth",
   "ll": [
    22.87874,
    37.90579
   ],
   "label": "above",
   "site": "Ancient Corinth, below Acrocorinth",
   "note": "Capital of the province of Achaia, on the isthmus between two seas. Paul stayed here \"a year and a half\" (18:11). An inscription from Delphi naming Gallio as proconsul dates his year to about AD 51–52, one of the firmest dates in Paul's life.",
   "ob": "a6f437a/corinth"
  },
  {
   "name": "Cenchrea",
   "ll": [
    22.99682,
    37.88434
   ],
   "label": "below",
   "site": "Kechries, on the Saronic Gulf",
   "note": "Corinth's eastern harbour, facing Asia; its sunken harbour works can still be seen. Here Paul had his head shaved \"to keep a vow he had made\" (18:18), a Jewish vow like the Nazirite vow of Numbers 6, and later he paid for others' vows in the Temple (21:23–26). Phoebe served the assembly at Cenchrea (Romans 16:1).",
   "ob": "aa31dd3/cenchreae"
  },
  {
   "name": "Ephesus",
   "ll": [
    27.3407,
    37.93912
   ],
   "label": "right",
   "site": "Ruins near Selçuk, Turkey",
   "note": "Capital of the province of Asia and one of the great cities of the empire, with the temple of Artemis. Paul leaves Priscilla and Aquila here, reasons in the synagogue, and promises to return \"if God is willing\" (18:21), which he does (19:1). The harbour has since silted up: the ruins now lie several kilometres from the sea.",
   "ob": "a5feb15/ephesus"
  },
  {
   "name": "Caesarea",
   "ll": [
    34.89167,
    32.5
   ],
   "label": "left",
   "site": "Caesarea Maritima, Israel",
   "note": "Herod the Great's port city, with an artificial harbour built out into the open sea, and the seat of the Roman governors of Judea. Paul lands here (18:22); later he is held here for two years (23:33–26:32).",
   "ob": "a58735e/caesarea"
  },
  {
   "name": "Jerusalem",
   "ll": [
    35.23417,
    31.77667
   ],
   "label": "below",
   "site": "Jerusalem",
   "note": "\"He went up and greeted the church\": one goes \"up\" to Jerusalem, and the BSB supplies \"at Jerusalem,\" as most commentators read it. Many manuscripts add to 18:21 Paul's words \"I must by all means keep this coming feast in Jerusalem\" (as in the KJV).",
   "ob": "a15257a/jerusalem"
  }
 ],
